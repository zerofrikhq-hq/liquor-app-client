# Server Port (default 5001 to prevent macOS AirPlay receiver collision on port 5000)
PORT=5001

# --- PostgreSQL Connection Options ---

# Option A: Full Connection URL (Recommended for Neon, Supabase, Render, ElephantSQL, AWS RDS, etc.)
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name?sslmode=require

# Option B: Individual Connection Parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mobile_app_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_SSL=false
